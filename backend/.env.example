# ============================================================
# PCA Backend Environment Configuration
# ============================================================

# ----------------------------
# Application
# ----------------------------
APP_NAME=PCA Backend
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# ----------------------------
# Database
# ----------------------------
# SQLite (default)
DATABASE_URL=sqlite+aiosqlite:///./pca.db

# Example PostgreSQL (future)
# DATABASE_URL=postgresql+asyncpg://username:password@localhost/pca_db

# ----------------------------
# Active AI Provider
# Supported:
#   mock
#   gemini
#   openai
#   claude
#   deepseek
#   ollama
# ----------------------------
ACTIVE_PROVIDER=mock

# ----------------------------
# Google Gemini
# ----------------------------
GOOGLE_API_KEY=

# Default Gemini model
GEMINI_MODEL=gemini-2.5-flash

# ----------------------------
# OpenAI
# ----------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# ----------------------------
# Anthropic Claude
# ----------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# ----------------------------
# DeepSeek
# Uses the OpenAI SDK
# ----------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ----------------------------
# Ollama
# ----------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ----------------------------
# AI Configuration
# ----------------------------
AI_TIMEOUT=60
AI_MAX_RETRIES=3

# ----------------------------
# API / CORS
# ----------------------------
CORS_ORIGINS=["*"]

# ============================================================
# End of File
# ============================================================